{
  // ---------------------------------------------------------------------------
  // SPPH 381H STUDENT WORKSPACE Codespace: R + Quarto + Python, beginner-ready.
  //
  // This is the small starter project students FORK in Week 2. Forking it and
  // opening a Codespace gives every student R, Quarto, Python, and the right
  // VS Code extensions automatically -- nothing to install by hand. It mirrors
  // the environment used by the HDSx course book so renders behave the same way.
  // (The HDSx book is a separate, read-only repository; students work HERE.)
  // ---------------------------------------------------------------------------
  "name": "SPPH 381H workspace (R + Quarto + Python)",

  // rocker "tidyverse" ships R + the whole tidyverse + the system libraries
  // students need, so renders work out of the box.
  // 🤖 AI edit (Claude), 2026-10-20: pinned by digest (was ":4", which moves
  // whenever rocker publishes a new R release). This is the R 4.6.1 image
  // built 2026-07-06. setup.sh installs extra R packages from the CRAN
  // snapshot of that same date: bump the two together.
  "image": "ghcr.io/rocker-org/devcontainer/tidyverse@sha256:3a9ecbed900f17da528cdb17c3ddc43045fc9b4be7dbd8c61cb7b8a6439bfa6b",

  // 🤖 AI edit (Claude), 2026-10-20: each feature pinned to an exact release
  // (was ":1", which takes the newest 1.x at build time).
  "features": {
    // Quarto CLI (bundles its own pandoc). HTML rendering works immediately.
    // TinyTeX off on purpose: students render HTML, not PDF.
    // 🤖 AI edit (Claude), 2026-10-20: pinned (was "release") so every
    // Codespace made this term renders with the same Quarto.
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1.1.5": {
      "version": "1.10.19",
      "installTinyTeX": "false"
    },
    // Python 3.11 for the Week 5 polyglot demo.
    // 🤖 AI edit (Claude), 2026-10-20: exact Python release (was "3.11", the
    // newest 3.11.x at build time). installTools off: the feature's linters
    // (pylint, black, ...) are unused in the course and were the last unpinned
    // Python downloads in the build.
    "ghcr.io/devcontainers/features/python:1.8.0": {
      "version": "3.11.17",
      "installTools": false
    }
  },

  "customizations": {
    "vscode": {
      // 🤖 AI edit (Claude), 2026-10-20: the four version pins below.
      // An extension installed at a stated version does not auto-update, so
      // the whole term runs on these releases (no pre-release builds). vscode-R
      // must match the sess that setup.sh installs from the same release: bump
      // both together. r-syntax is a dependency vscode-R 3.x pulls in.
      // The Python, Jupyter and Copilot extensions stay unpinned on purpose:
      // they use VS Code's proposed APIs, which change between VS Code
      // releases, and Codespaces always runs the newest VS Code, so an old
      // pinned copy could stop loading.
      "extensions": [
        "quarto.quarto@1.138.0",
        "REditorSupport.r@3.2.0",
        "REditorSupport.r-syntax@0.1.4",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "mechatroner.rainbow-csv@3.24.1",
        // 🤖 AI edit (Claude), 2026-10-20: the two viewers below.
        // Clicking a rendered .html or .pdf in the Explorer opens it in an
        // editor tab, read straight from disk. Unlike the Quarto preview pane,
        // they use no forwarded port, so they work in the browser client;
        // plotly, DT and revealjs run (tested in a Codespace).
        "analytic-signal.preview-html@1.0.0",
        "mathematic.vscode-pdf@0.2.6"
      ],
      "settings": {
        "r.rterm.linux": "/usr/local/bin/R",
        "r.bracketedPaste": true,
        // 🤖 AI edit (Claude), 2026-09-29: the two settings below.
        // Plots from Run Cell appear as images in a VS Code tab. The image's
        // default (httpgd) embeds a forwarded port, which the Codespaces
        // browser client shows as a blank pane.
        "r.plot.backend": "standard",
        // Preview still renders on save but opens nothing: its side pane comes
        // up blank for the same reason, and its browser tab lands on "Not
        // Found". Rendered files are viewed in a preview tab (the viewer
        // extensions above) or through port 8000 (below) instead.
        "quarto.render.previewType": "none",
        // 🤖 AI edit (Claude), 2026-10-20: the setting below.
        // Run Cell goes straight to a plain R terminal. Otherwise vscode-R 3.2
        // first asks where to run, defaulting to its experimental "R
        // Interactive" window, which needs the arf console (not installed).
        "r.interactive.executionTarget": "terminal",
        "editor.formatOnSave": false
      }
    }
  },

  // Runs once after the container is built. Installs the few extra packages and
  // self-tests the toolchain. The leading sed strips stray carriage returns so
  // the script runs even if the file was copied without git's eol=lf handling.
  "postCreateCommand": "sed -i 's/\\r$//' .devcontainer/setup.sh && bash .devcontainer/setup.sh",

  // 🤖 AI edit (Claude), 2026-09-29: this block.
  // Serves the workspace so rendered HTML (and PDF) opens in a browser tab:
  // Ports tab -> "Rendered reports" -> globe icon -> click the file. The front
  // page is a file list, because Codespaces always opens a port's front page.
  // Runs each time VS Code connects, as a foreground server like typing it in a
  // terminal. (A detached postStartCommand server did not survive startup.)
  // Bound to 127.0.0.1 so only Codespaces' own forwarding can reach it. It
  // serves the whole workspace, .git included, so keep the port private.
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Rendered reports", "onAutoForward": "silent" }
  },
  "postAttachCommand": {
    "reports": "python3 -m http.server 8000 --bind 127.0.0.1"
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  }
}
